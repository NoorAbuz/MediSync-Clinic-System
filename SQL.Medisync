-- Create Database
CREATE DATABASE IF NOT EXISTS medisync;
USE medisync;

-- Drop existing tables (for re-runs)
DROP TABLE IF EXISTS Prescription, MedicalRecord, Appointment, Doctor, Patient, Specialization, User;

-- Create Tables

CREATE TABLE User (
    user_id INT AUTO_INCREMENT PRIMARY KEY,
    name VARCHAR(100),
    email VARCHAR(100) UNIQUE,
    username VARCHAR(50) UNIQUE,
    password VARCHAR(100),
    role ENUM('patient', 'doctor', 'admin'),
    contact_info VARCHAR(100)
);

CREATE TABLE Patient (
    patient_id INT PRIMARY KEY,
    FOREIGN KEY (patient_id) REFERENCES User(user_id)
);

CREATE TABLE Specialization (
    spec_id INT AUTO_INCREMENT PRIMARY KEY,
    name VARCHAR(100) UNIQUE
);

CREATE TABLE Doctor (
    doctor_id INT PRIMARY KEY,
    specialization_id INT,
    years_of_experience INT,
    FOREIGN KEY (doctor_id) REFERENCES User(user_id),
    FOREIGN KEY (specialization_id) REFERENCES Specialization(spec_id)
);

CREATE TABLE Appointment (
    appointment_id INT AUTO_INCREMENT PRIMARY KEY,
    doctor_id INT,
    patient_id INT,
    appointment_date DATE,
    appointment_time TIME,
    status ENUM('scheduled', 'completed', 'cancelled'),
    UNIQUE(doctor_id, appointment_date, appointment_time),
    FOREIGN KEY (doctor_id) REFERENCES Doctor(doctor_id),
    FOREIGN KEY (patient_id) REFERENCES Patient(patient_id)
);

CREATE TABLE MedicalRecord (
    record_id INT AUTO_INCREMENT PRIMARY KEY,
    appointment_id INT,
    patient_id INT,
    diagnosis TEXT,
    notes TEXT,
    FOREIGN KEY (appointment_id) REFERENCES Appointment(appointment_id),
    FOREIGN KEY (patient_id) REFERENCES Patient(patient_id)
);

CREATE TABLE Prescription (
    prescription_id INT AUTO_INCREMENT PRIMARY KEY,
    doctor_id INT,
    patient_id INT,
    medication_name VARCHAR(100),
    dosage VARCHAR(50),
    duration VARCHAR(50),
    FOREIGN KEY (doctor_id) REFERENCES Doctor(doctor_id),
    FOREIGN KEY (patient_id) REFERENCES Patient(patient_id)
);

